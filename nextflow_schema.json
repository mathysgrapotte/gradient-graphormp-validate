{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gradient-evals/biomlbench-drug-polaris-adme-fang-hclint-1/main/nextflow_schema.json",
  "title": "BioML-bench polaris/adme-fang-hclint-1 pipeline parameters",
  "description": "Stimulus-ready baseline for the polaris/adme-fang-hclint-1 drug-discovery task.",
  "type": "object",
  "$defs": {
    "task_identity": {
      "title": "Task identity",
      "type": "object",
      "description": "Pinned constants that define the benchmark and its grader. Do not tune.",
      "properties": {
        "benchmark_id": {
          "type": "string",
          "default": "polaris/adme-fang-hclint-1",
          "description": "Polaris/TDC benchmark id."
        },
        "main_metric": {
          "type": "string",
          "default": "pearsonr",
          "description": "Polaris main metric, becomes result.objective."
        },
        "objective_mode": {
          "type": "string",
          "default": "maximize",
          "enum": [
            "minimize",
            "maximize"
          ],
          "description": "Optimisation direction."
        },
        "task_type": {
          "type": "string",
          "default": "regression",
          "enum": [
            "regression",
            "classification"
          ],
          "description": "Estimator head."
        }
      }
    },
    "data": {
      "title": "Data",
      "type": "object",
      "description": "Pinned, immutable dataset prefix. Staged+validated, never split at runtime.",
      "properties": {
        "dataset_s3_prefix": {
          "type": "string",
          "default": "s3://seqera-eval-data-128997144437-eu-west-3/data/drug/polaris-adme-fang-hclint-1/v1-90489b8d",
          "description": "Versioned, content-addressed S3 prefix holding public/ + private/answers.csv."
        }
      }
    },
    "run": {
      "title": "Run / output",
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "default": "polaris_adme_fang_hclint_1_run",
          "description": "Run identifier used to tag outputs."
        },
        "outdir": {
          "type": "string",
          "default": "results",
          "description": "Output directory."
        },
        "publish_dir_mode": {
          "type": "string",
          "default": "copy",
          "enum": [
            "copy",
            "symlink",
            "link",
            "rellink"
          ]
        }
      }
    },
    "model": {
      "title": "Baseline model surface (Stimulus search space)",
      "type": "object",
      "properties": {
        "model_family": {
          "type": "string",
          "default": "ridge",
          "enum": [
            "ridge",
            "random_forest",
            "hist_gradient_boosting",
            "graphormer"
          ],
          "description": "Model module: classical Morgan/sklearn baseline, or 'graphormer' (PCQM4Mv2-pretrained graph-transformer fine-tune)."
        },
        "morgan_radius": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 6,
          "description": "Morgan/ECFP radius."
        },
        "morgan_bits": {
          "type": "integer",
          "default": 1024,
          "description": "Morgan fingerprint length."
        },
        "ridge_alpha": {
          "type": "number",
          "default": 1.0,
          "description": "Ridge L2 strength (regression)."
        },
        "logistic_c": {
          "type": "number",
          "default": 1.0,
          "description": "Logistic inverse-regularisation (classification)."
        },
        "rf_n_estimators": {
          "type": "integer",
          "default": 300,
          "description": "Random-forest tree count."
        },
        "hgb_learning_rate": {
          "type": "number",
          "default": 0.1,
          "description": "Hist-gradient-boosting learning rate."
        },
        "seed": {
          "type": "integer",
          "default": 17,
          "description": "Random seed."
        }
      }
    },
    "graphormer": {
      "title": "Pretrained-Graphormer fine-tune surface (Stimulus search space)",
      "type": "object",
      "description": "Knobs for the 'graphormer' arm: a PCQM4Mv2-pretrained graph transformer fine-tuned on the target. Active only when model_family == 'graphormer'.",
      "properties": {
        "gr_finetune_mode": {
          "type": "string",
          "default": "lpft",
          "enum": [
            "frozen",
            "full",
            "lpft"
          ],
          "description": "Fine-tuning regime: frozen featuriser + head, full end-to-end, or linear-probe-then-fine-tune (LP-FT)."
        },
        "gr_head": {
          "type": "string",
          "default": "mlp",
          "enum": [
            "linear",
            "mlp"
          ],
          "description": "Prediction head on the graph-token embedding."
        },
        "gr_lr": {
          "type": "number",
          "default": 1e-4,
          "description": "Fine-tune learning rate (AdamW)."
        },
        "gr_epochs": {
          "type": "integer",
          "default": 6,
          "minimum": 1,
          "maximum": 12,
          "description": "Fine-tune epochs (end-to-end phase)."
        },
        "gr_ensemble": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "Number of seed-averaged ensemble members."
        },
        "gr_batch_size": {
          "type": "integer",
          "default": 16,
          "enum": [
            8,
            16,
            32
          ],
          "description": "Mini-batch size."
        },
        "gr_weight_decay": {
          "type": "number",
          "default": 1e-2,
          "description": "AdamW weight decay."
        },
        "gr_head_dropout": {
          "type": "number",
          "default": 0.1,
          "minimum": 0.0,
          "maximum": 0.6,
          "description": "Dropout in the prediction head."
        },
        "gr_freeze_layers": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 12,
          "description": "Freeze the bottom N of 12 transformer layers (gradual unfreezing)."
        },
        "gr_fuse_descriptors": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "on"
          ],
          "description": "Fuse Morgan fingerprints + RDKit 2D descriptors with the graph embedding before the head."
        }
      }
    },
    "containers": {
      "title": "Containers",
      "type": "object",
      "description": "Single durable community.wave.seqera.io image (built from conda/environment.yml) with the PCQM4Mv2 Graphormer checkpoint + compiled spatial-encoding extension baked in. Stimulus overrides per study.",
      "properties": {
        "prepare_container": {
          "type": "string",
          "default": "community.wave.seqera.io/library/hclint-graphormp:1dd0688825d0a4f4"
        },
        "model_container": {
          "type": "string",
          "default": "community.wave.seqera.io/library/hclint-graphormp:1dd0688825d0a4f4"
        },
        "grade_container": {
          "type": "string",
          "default": "community.wave.seqera.io/library/hclint-graphormp:1dd0688825d0a4f4"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/task_identity"
    },
    {
      "$ref": "#/$defs/data"
    },
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/model"
    },
    {
      "$ref": "#/$defs/graphormer"
    },
    {
      "$ref": "#/$defs/containers"
    }
  ]
}
