/*
 * Resource-tier definitions. Modules declare a `label` and this file maps it
 * to concrete resources, so compute cost is tuned from one place. On a cloud
 * executor add `machineType` per label in a site-specific config.
 */

process {
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'terminate' }
    maxRetries    = 1

    withLabel: 'process_single' {
        cpus   = 1
        memory = 2.GB
        time   = 30.min
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = 6.GB
        time   = 2.h
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 16.GB
        time   = 4.h
    }
}
