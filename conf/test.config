/*
 * Local container-free profile for laptop verification.
 *
 * Disables Wave/Docker so processes run with the binaries on PATH (the bin/
 * scripts plus a Python env carrying polaris, rdkit, scikit-learn). Use:
 *
 *   nextflow run . -profile test --outdir results
 */

docker { enabled = false }
wave   { enabled = false }

process {
    executor = 'local'
}
