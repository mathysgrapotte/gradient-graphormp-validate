/*
 * BioML-bench evaluation pipeline — polaris/adme-fang-hclint-1 (drug discovery).
 *
 * Defaults mirror nextflow_schema.json. The model knobs are the Stimulus
 * search-space surface; the task/grader knobs are pinned constants.
 */

nextflow.enable.dsl = 2

params {
    // ---- Task identity (pinned constants — do not tune) ----
    benchmark_id   = 'polaris/adme-fang-hclint-1'
    main_metric    = 'pearsonr'
    objective_mode = 'maximize'
    task_type      = 'regression'

    // ---- Data (prepared+pinned once off-pipeline, staged from S3 via Fusion) ----
    // Immutable, content-addressed prefix; bump the version to point at new data.
    dataset_s3_prefix = 's3://seqera-eval-data-128997144437-eu-west-3/data/drug/polaris-adme-fang-hclint-1/v1-90489b8d'

    // ---- Run identity / outputs ----
    run_id           = 'polaris_adme_fang_hclint_1_run'
    outdir           = 'results'
    publish_dir_mode = 'copy'

    // ---- Baseline model surface (the Stimulus-tunable knobs) ----
    model_family      = 'ridge'
    morgan_radius     = 2
    morgan_bits       = 1024
    ridge_alpha       = 1.0
    logistic_c        = 1.0
    rf_n_estimators   = 300
    hgb_learning_rate = 0.1
    seed              = 17

    // ---- Per-stage containers (build once via Wave — see README) ----
    prepare_container = 'gradient-evals/biomlbench-drug:latest'
    model_container   = 'gradient-evals/biomlbench-drug:latest'
    grade_container   = 'gradient-evals/biomlbench-drug:latest'

    // ---- Validation ----
    validate_params = true
}

includeConfig 'conf/base.config'

docker { enabled = true }
wave   { enabled = true }

process {
    cache        = 'lenient'
    beforeScript = 'export PYTHONUNBUFFERED=1'

    publishDir = [
        path: { "${params.outdir}/${params.run_id}" },
        mode: params.publish_dir_mode,
    ]
}

profiles {
    test { includeConfig 'conf/test.config' }
}

manifest {
    name            = 'biomlbench-drug-polaris-adme-fang-hclint-1'
    description     = 'BioML-bench polaris/adme-fang-hclint-1 baseline, Stimulus-ready (Nextflow DSL2).'
    version         = '0.1.0'
    nextflowVersion = '>=24.04'
    mainScript      = 'main.nf'
}
