/*
 * BioML-bench evaluation pipeline — polaris/adme-fang-hclint-1 (drug discovery).
 *
 * Defaults mirror nextflow_schema.json. The model knobs are the Stimulus
 * search-space surface; the task/grader knobs are pinned constants.
 */

nextflow.enable.dsl = 2

params {
    // ---- Task identity (pinned constants — do not tune) ----
    benchmark_id   = 'polaris/adme-fang-hclint-1'
    main_metric    = 'pearsonr'
    objective_mode = 'maximize'
    task_type      = 'regression'

    // ---- Data (prepared+pinned once off-pipeline, staged from S3 via Fusion) ----
    // Immutable, content-addressed prefix; bump the version to point at new data.
    dataset_s3_prefix = 's3://seqera-eval-data-128997144437-eu-west-3/data/drug/polaris-adme-fang-hclint-1/v1-90489b8d'

    // ---- Run identity / outputs ----
    run_id           = 'polaris_adme_fang_hclint_1_run'
    outdir           = 'results'
    publish_dir_mode = 'copy'

    // ---- Baseline model surface (the Stimulus-tunable knobs) ----
    // model_family selects the model module: the classical Morgan/sklearn
    // baseline ('ridge'/'random_forest'/'hist_gradient_boosting') or the
    // pretrained-Graphormer fine-tune ('graphormer').
    model_family      = 'ridge'
    morgan_radius     = 2
    morgan_bits       = 1024
    ridge_alpha       = 1.0
    logistic_c        = 1.0
    rf_n_estimators   = 300
    hgb_learning_rate = 0.1
    seed              = 17

    // ---- Pretrained-Graphormer fine-tune surface (the 'graphormer' arm) ----
    gr_finetune_mode    = 'lpft'      // frozen | full | lpft (linear-probe then fine-tune)
    gr_head             = 'mlp'       // linear | mlp
    gr_lr               = 1e-4
    gr_epochs           = 6
    gr_ensemble         = 2
    gr_batch_size       = 16
    gr_weight_decay     = 1e-2
    gr_head_dropout     = 0.1
    gr_freeze_layers    = 0           // freeze the bottom N of 12 transformer layers
    gr_fuse_descriptors = 'off'       // off | on (Morgan + RDKit 2D fusion before the head)

    // ---- Per-stage containers ----
    // Single durable image frozen to the public Seqera community registry from
    // conda/environment.yml (torch+transformers+rdkit+sklearn, with the PCQM4Mv2
    // Graphormer checkpoint + compiled spatial-encoding extension baked in). Pulls
    // directly (no Wave token), so it never goes stale. Stimulus overrides per study.
    prepare_container = 'community.wave.seqera.io/library/hclint-graphormp:1dd0688825d0a4f4'
    model_container   = 'community.wave.seqera.io/library/hclint-graphormp:1dd0688825d0a4f4'
    grade_container   = 'community.wave.seqera.io/library/hclint-graphormp:1dd0688825d0a4f4'

    // ---- Validation ----
    validate_params = true
}

includeConfig 'conf/base.config'

docker { enabled = true }
wave   { enabled = true }

process {
    cache        = 'lenient'
    beforeScript = 'export PYTHONUNBUFFERED=1'

    publishDir = [
        path: { "${params.outdir}/${params.run_id}" },
        mode: params.publish_dir_mode,
    ]
}

profiles {
    test { includeConfig 'conf/test.config' }
}

manifest {
    name            = 'biomlbench-drug-polaris-adme-fang-hclint-1'
    description     = 'BioML-bench polaris/adme-fang-hclint-1 baseline, Stimulus-ready (Nextflow DSL2).'
    version         = '0.1.0'
    nextflowVersion = '>=24.04'
    mainScript      = 'main.nf'
}
